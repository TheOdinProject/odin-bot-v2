{
  "name": "bot-v2",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "start": "node index.js",
    "dev": "nodemon --watch . --watch .env index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "migrate": "dbmate up",
    "migrate:only": "dbmate --no-dump-schema up",
    "migrate:rollback": "dbmate rollback",
    "migrate:new": "dbmate new",
    "migrate:status": "dbmate status --exit-code",
    "format": "prettier --cache --write",
    "eslint": "eslint"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dbmate": "^2.33.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "glob": "^13.0.6",
    "ioredis": "^5.10.1",
    "pg": "^8.22.0",
    "prettier": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.8",
    "nodemon": "^3.1.14"
  },
  "lint-staged": {
    "!(*.js)": "prettier --check --ignore-unknown",
    "*.js": [
      "prettier --check",
      "eslint"
    ]
  }
}
